# Bản mẫu biến môi trường cho Vite
# Sao chép thành .env.local hoặc .env cho môi trường phát triển/production.
# Không commit file .env hoặc .env.local.

# Tên app hiển thị trên giao diện
VITE_APP_NAME="Website Ôn Tập"

# Chọn storage backend: local hoặc supabase
# - local: lưu dữ liệu trong IndexedDB trên trình duyệt
# - supabase: dùng Supabase sau này, cần thêm URL + anon key dưới đây
VITE_STORAGE_PROVIDER="local"

# Base path khi deploy lên GitHub Pages / host tĩnh
# Ví dụ: /website-on-tap/ hoặc /
VITE_BASE_PATH="/"

# Bắt buộc khi VITE_STORAGE_PROVIDER=supabase
VITE_SUPABASE_URL="https://example.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
